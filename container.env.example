# mybox container.env — runtime configuration read INSIDE the container.
#
# Copy to /srv/<name>/container.env and wire it via the 05-user.conf
# drop-in (`EnvironmentFile=/srv/%p/container.env`) or podman
# `--env-file`. Plain KEY=VALUE lines; podman reads it on the HOST at
# container start, systemd PID 1 propagates the vars to every unit.
#
# All vars are optional — defaults shown.

# Login user created at boot by mybox-user-setup.service (wheel +
# NOPASSWD sudo, empty password — auth via ssh keys or podman exec).
MYBOX_USER=user
MYBOX_UID=1000
MYBOX_GID=1000
MYBOX_SHELL=/usr/bin/fish

# SSH keys for the user, comma-separated. Synced every boot to
# /etc/ssh/authorized_keys.d/<user>; leave unset to manage keys via
# ~/.ssh/authorized_keys or a bind mount (see 05-user.conf).
#MYBOX_AUTHORIZED_KEYS=ssh-ed25519 AAAA... you@host
