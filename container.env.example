# mybox container.env — per-instance runtime configuration.
#
# Copy this to /srv/<name>/container.env and edit. No wiring needed:
# mybox.container already loads it (EnvironmentFile=/srv/%p/container.env)
# and creates an empty one on first start, so mybox-1 and mybox-2 each get
# their own. Plain KEY=VALUE lines, read on the HOST at container start;
# PID 1 then carries them to mybox-user-setup.
#
# Apply changes with `just restart` — it is read at container creation.
#
# Note Environment= in a *.container.d drop-in WINS over this file, which
# is why the shipped 05-user.conf keeps its lines commented.
#
# All vars are optional — the values below are the built-in defaults.

# Login user created at boot by mybox-user-setup.service (wheel +
# NOPASSWD sudo, empty password — auth via ssh keys or podman exec).
MYBOX_USER=user
MYBOX_UID=1000
MYBOX_GID=1000
MYBOX_SHELL=/usr/bin/fish

# SSH keys for the user, comma-separated. Synced every boot to
# /etc/ssh/authorized_keys.d/<user>; leave unset to manage keys via
# ~/.ssh/authorized_keys or a bind mount (see 05-user.conf).
#MYBOX_AUTHORIZED_KEYS=ssh-ed25519 AAAA... you@host
