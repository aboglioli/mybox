# mybox-bridge.network — join the host's existing br0 (libvirt-style).
#
# The container's veth becomes a real member of br0 → own LAN IP,
# pingable from the LAN, DHCP'd by the LAN's server, reachable from
# the host (unlike macvlan). Requires br0 to exist with the LAN NIC
# enslaved, plus `netavark-dhcp-proxy.socket` enabled for IPAM=dhcp.
#
# Why this over macvlan on such hosts: macvlan can't attach to a
# bridge slave ("Device or resource busy") nor to the bridge itself
# (broken ARP forwarding).

[Network]
NetworkName=mybox-lan
Driver=bridge
# JOIN the existing br0 instead of creating a bridge; mode=unmanaged
# stops netavark from managing it (bridge stays under libvirt/your
# control). --interface-name has no native [Network] key in podman 5.x.
PodmanArgs=--interface-name br0
Options=mode=unmanaged
IPAMDriver=dhcp

# Static IPAM alternative — replace IPAMDriver=dhcp and mode=unmanaged,
# pin the address with the 80-static-ip.conf drop-in:
# Subnet=192.168.100.0/24
# Gateway=192.168.100.1
