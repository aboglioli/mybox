# mybox-lan.network — the container is an independent host on your LAN, via
# macvlan on a physical NIC. For hosts with no bridge; where br0 exists use
# mybox-br0.network, which gives the same thing plus host access.
#
# Requirements, all of them real:
#   * WIRED nic. Wifi drivers refuse macvlan children.
#   * The NIC must not be a bridge slave — the kernel rejects that with
#     `RTNETLINK answers: Device or resource busy`. parent=br0 (the bridge,
#     not its slave) is accepted but pointless: same isolation, extra MAC.
#   * netavark-dhcp-proxy.socket enabled on the host, for IPAM=dhcp.
#     (myosi's containers profile upholds it already.)
#
# THE HOST CANNOT TALK TO THE CONTAINER over macvlan, and vice versa. Every
# other machine on the LAN can.
#
# Set parent= to the NIC holding your LAN route:
#   ip -o route get 1.1.1.1 | awk '{print $5}'

[Network]
NetworkName=mybox-lan
Driver=macvlan
Options=parent=enp108s0
Options=mode=bridge
IPAMDriver=dhcp

# Static instead of DHCP: drop IPAMDriver, declare the subnet here, pin the
# address with 80-static-ip.conf. Pick one outside the router's DHCP pool.
# Subnet=192.168.0.0/24
# Gateway=192.168.0.1
