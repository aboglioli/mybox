# mybox-macvlan.network — own LAN IP via macvlan on a physical NIC.
#
# Requires the NIC to NOT be enslaved to a bridge (kernel rejects
# macvlan on a bridge slave) — hosts with a libvirt-style br0 use
# mybox-bridge.network instead. Wired only (wifi drivers reject
# macvlan children). Host cannot reach the container over macvlan
# (kernel restriction). DHCP needs `netavark-dhcp-proxy.socket`.
#
# Edit `parent=` to your LAN NIC: ip -o route get 1.1.1.1 | awk '{print $5}'

[Network]
NetworkName=mybox-lan
Driver=macvlan
Options=parent=enp1s0
Options=mode=bridge
IPAMDriver=dhcp

# Static IPAM alternative — drop IPAMDriver=dhcp, pin the address with
# the 80-static-ip.conf drop-in:
# Subnet=192.168.100.0/24
# Gateway=192.168.100.1
