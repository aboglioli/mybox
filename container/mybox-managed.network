# mybox-managed.network — podman-managed bridge, NAT outbound.
#
# Works on any host (no LAN topology assumptions, wifi OK) at the cost
# of the "own LAN identity" model. Inbound needs PublishPort= in the
# .container (e.g. PublishPort=2222:2222 for sshd).

[Network]
NetworkName=mybox-lan
Driver=bridge
Subnet=10.89.0.0/24
Gateway=10.89.0.1
# DisableDNS=true   # skip podman's DNS
