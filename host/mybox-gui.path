# Starts mybox once the desktop session is ready (GUI hosts only).
#
# 10-gui.conf binds host session sockets that only exist once a compositor
# runs, so a GUI host can't boot-start; that drop-in cancels the boot
# wiring and this unit replaces it. The wayland socket appearing means
# home decrypted, user logged in, compositor up.
#
# Install: cp to /etc/systemd/system/ and `systemctl enable --now`.
# `just install` does it for you. Adjust PathExists= for your uid and
# compositor (wayland-0 on GNOME/KDE), Unit= for a renamed instance.
#
# Fires once per boot. Re-login does NOT re-attach the sockets — a bind
# pins the inode, so run `just restart` after logging back in.
# See host/README.md.

[Unit]
Description=Start mybox when the desktop session is ready
Documentation=https://github.com/aboglioli/mybox

[Path]
PathExists=/run/user/1000/wayland-1
Unit=mybox.service

[Install]
WantedBy=multi-user.target
