# mybox.container — rootful system container quadlet (minimal base).
#
# Rootful on purpose: rootless quadlets can't give this use case an own
# LAN IP, :idmap binds, or a wide subuid range for nested rootless
# podman. The userns remap below keeps the workload off host root.
#
# This base carries ONLY identity + security + network. Everything else
# composes via drop-ins in <name>.container.d/ (see container/ in this
# repo; `just install` symlinks them). Every path derives from the unit
# name via %p, so copying this file to another name self-derives its
# container name and /srv/<name> state dir. NOTE: %p keeps dashes
# literally; %P would unescape them to slashes — never use %P here.
#
# Install: `just install && just start` (see justfile), or copy this
# file + a .network file + drop-ins into /etc/containers/systemd/ and
# `systemctl daemon-reload && systemctl start mybox`. Quadlets cannot be
# `enable`d — [Install] wires boot via the generator.
#
# Lifecycle (with 01-persist-root.conf):
#   config change   edit drop-in → daemon-reload → restart (state kept)
#   image rebase    rebuild/pull image → restart
#   factory reset   stop → rm -rf /srv/<name>/{etc,var} → start

[Unit]
Description=%p — rootful system container (systemd PID 1)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=%p
HostName=%p
# Published from CI on release tags (YYYY.MM.DD[.XX]); :latest tracks
# the newest release and lets AutoUpdate=registry roll forward. Pin a
# date tag here (and in 01-persist-root.conf) to freeze. Local dev:
# `just build` tags a local build over this same reference.
Image=ghcr.io/aboglioli/mybox:latest
Exec=/sbin/init

# Register with host systemd-machined: machinectl shell/login, journalctl -M.
Annotation=run.oci.systemd.machine=true

# Hardened set (see README "Security posture"). The userns remap is the
# load-bearing control; capabilities are namespaced by it. Kept to the
# minimum systemd PID 1 + nested podman need: SYS_ADMIN (mounts/
# nesting), SYS_NICE, MKNOD. Default seccomp; /proc stays masked.
# NET_ADMIN/NET_RAW deliberately absent — eth0 is configured host-side
# by netavark, and nested rootless podman gains its own CAP_NET_ADMIN
# in the userns it creates; 40-virt.conf / 70-vpn.conf append them when
# the feature needs them.
AddCapability=SYS_ADMIN SYS_NICE MKNOD

# SELinux: the one remaining relaxation — container_t breaks boot.
SecurityLabelDisable=true

# Auto-allocated userns from /etc/subuid[containers]. Size=200000 so the
# image's inner subuid pool (100000:65536) fits for nested podman.
UserNS=auto:size=200000

# No native [Container] keys for these (podman 5.x).
PodmanArgs=--systemd=always
PodmanArgs=--cgroupns=private

Tmpfs=/run
Tmpfs=/tmp
Tmpfs=/var/tmp

# Persistent state — REQUIRED, not a drop-in. The container is
# recreated on every stop/reload/boot, so everything writable lives on
# the host under /srv/<name> (derived from the unit name via %p, so
# mybox-1.container gets /srv/mybox-1 and never collides).
#
#   /etc   system config: preset symlinks, users, sshd keys
#   /var   system state — AND the /usr + /opt overlay upperdirs that
#          mybox-usr-overlay.service mounts at boot. This is why the
#          bind is not optional: an upperdir cannot live on the
#          container's own overlayfs, the kernel refuses it, and /usr
#          would stay read-only (no pacman, no NVIDIA userland)
#   /home  user data — outlives factory resets of /etc + /var
#   /srv   service data for nested quadlets
#
# `:idmap` keeps host-side ownership at the container's numeric UIDs.
# Factory reset: stop → sudo rm -rf /srv/<name>/{etc,var} → start.
# Throwaway instance: give it its own name, delete /srv/<name> after.
Volume=/srv/%p/etc:/etc:idmap
Volume=/srv/%p/var:/var:idmap
Volume=/srv/%p/home:/home:idmap
Volume=/srv/%p/srv:/srv:idmap

# /dev/net/tun: pasta opens it in-namespace — without it every nested
# rootless `podman run` fails. /dev/fuse: flatpak's document portal
# (hard FUSE dep) + the fuse-overlayfs storage fallback on ephemeral
# runs. Devices only — no extra capabilities for this.
AddDevice=/dev/fuse
AddDevice=/dev/net/tun

# Sessions inherit PID 1's memlock limit (image ships no limits.d entry —
# pam_limits would fail user@.service when the cap is lower). 3 GiB
# covers real-time audio, Wine/Proton, mmap-heavy loads.
Ulimit=memlock=3221225472:3221225472

# Network — pick ONE (switch via drop-in: `Network=` empty, then value):
#   mybox-bridge.network    join existing host br0 → real LAN IP (default)
#   mybox-macvlan.network   own LAN IP on a physical NIC (not bridged)
#   mybox-managed.network   podman NAT bridge — works everywhere
#   host                    share host netns (sshd on :2222)
Network=mybox-bridge.network

# DNS is baked into the image (resolved.conf.d + nsswitch `resolve`) —
# netavark's DHCP overwrites /etc/resolv.conf, so DNS= here would not
# survive.

AutoUpdate=registry

[Service]
Restart=on-failure
TimeoutStartSec=600

# The state dirs are created on demand, so a new <name>.container just
# works — no manual mkdir before the first start.
ExecStartPre=/usr/bin/mkdir -p /srv/%p/etc /srv/%p/var /srv/%p/home /srv/%p/srv

# HOST-SIDE first-boot seeding via a throwaway container. PID 1 reads
# /etc (machine-id, preset enable symlinks) before any in-container
# unit could seed it, so an empty bind must be populated beforehand —
# this is what makes `enable` in the image reach the first boot, and
# why mybox needs no Wants=/Upholds= drop-ins to bootstrap itself. The
# in-container mybox-{etc,var}-seed.service remain as fallback for a
# hand-rolled `podman run`.
#
# The seed run is deliberately WITHOUT userns/idmap: it writes real
# numeric uids that the main container then views through its :idmap
# binds (`:idmap` here would invert the mapping and EACCES).
# label=disable matches the main container. KEEP THE IMAGE REFERENCE IN
# SYNC WITH Image= ABOVE.
ExecStartPre=/bin/sh -c 'test -n "$(ls -A /srv/%p/etc)" || podman run --rm --security-opt label=disable -v /srv/%p/etc:/seed ghcr.io/aboglioli/mybox:latest cp -a /usr/share/factory/etc/. /seed/'
ExecStartPre=/bin/sh -c 'test -n "$(ls -A /srv/%p/var)" || podman run --rm --security-opt label=disable -v /srv/%p/var:/seed ghcr.io/aboglioli/mybox:latest cp -a /usr/share/factory/var/. /seed/'

[Install]
WantedBy=multi-user.target
