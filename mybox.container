# mybox.container — rootful system container quadlet (shared base).
#
# Installed as <name>@.container.d/00-base.conf, NOT as a unit file: mybox
# runs as two mutually exclusive INSTANCES of one template —
#
#   <name>@headless.service   boot-starts, no session sockets
#   <name>@gui.service        the same box plus the host wayland/audio sockets
#
# — and a quadlet drop-in directory named <name>@.container.d/ is the one
# place both instances read. The instance files themselves (mybox@headless
# .container, mybox@gui.container) are stubs that carry only the wiring
# that differs. %p is <name> for BOTH instances, so every path below is
# shared automatically: same /srv/<name>, same ContainerName, same image.
# Only one may run at a time — they mount the same overlay uppers.
#
# Rootful on purpose: rootless quadlets can't give this use case an own
# LAN IP, :idmap binds, or a wide subuid range for nested rootless
# podman. The userns remap below keeps the workload off host root.
#
# This base carries ONLY identity + security + network. Everything else
# composes via drop-ins in <name>.container.d/ (see container/ in this
# repo; `just install` symlinks them). Every path derives from the unit
# name via %p, so copying this file to another name self-derives its
# container name and /srv/<name> state dir. NOTE: %p keeps dashes
# literally; %P would unescape them to slashes — never use %P here.
#
# Install: `just install && just start` (see justfile), or copy this file
# to /etc/containers/systemd/<name>@.container.d/00-base.conf, add a
# .network file, the instance stubs and any drop-ins, then
# `systemctl daemon-reload && systemctl start <name>@headless`. Quadlets
# cannot be `enable`d — [Install] wires boot via the generator, and it
# lives in the headless stub so only that instance boot-starts.
#
# COPY these files, never symlink them from /home: generators run before
# any mount, so such a link is unreadable and NO unit gets generated.
#
# Lifecycle:
#   config change   edit drop-in → daemon-reload → restart (state kept)
#   image rebase    rebuild/pull image → restart
#   factory reset   stop → rm -rf /srv/<name>/{etc,var} → start

[Unit]
# Bound the damage if the two instances ever do overlap. They share
# ContainerName, so each one's --replace deletes the other's container;
# the loser exits 137, Restart= brings it back, and at the 100ms default
# that becomes a self-sustaining loop. Three tries a minute lets a genuine
# crash recover while a fight burns itself out and stays down, visibly.
StartLimitIntervalSec=60
StartLimitBurst=3
Description=%p (%i) — rootful system container (systemd PID 1)
After=network-online.target
Wants=network-online.target
# /srv/%p may be its own filesystem; don't start before it is mounted.
RequiresMountsFor=/srv/%p

[Container]
ContainerName=%p
HostName=%p
# Published from CI on release tags (YYYY.MM.DD[.XX]); :latest tracks
# the newest release and lets AutoUpdate=registry roll forward. Pin a
# date tag here (and in the seed ExecStartPre below) to freeze. Local dev:
# `just build` tags a local build over this same reference.
Image=ghcr.io/aboglioli/mybox:latest
# Not /sbin/init directly: the pre-init assembles the root filesystem
# (every image-owned tree as an overlay over the host state bind) and then
# execs systemd, which PID 1 could not do for itself — it reads /etc before
# any unit runs. podman still treats this as a systemd container because
# --systemd=always is set explicitly below.
Exec=/usr/libexec/mybox/preinit

# Register with host systemd-machined: machinectl shell/login, journalctl -M.
Annotation=run.oci.systemd.machine=true

# Hardened set (see README "Security posture"). The userns remap is the
# load-bearing control; capabilities are namespaced by it. SYS_ADMIN
# (mounts/nesting), SYS_NICE, MKNOD, plus NET_ADMIN/NET_RAW.
#
# The net caps are there for NESTED ROOTFUL PODMAN, which is a first-class
# thing to do on a daily driver: `sudo podman run` inside makes netavark
# build a bridge, a veth pair and nftables rules in the container's OWN
# network namespace, and without CAP_NET_ADMIN that dies with
#
#   Error: netavark: Netlink error: Operation not permitted (os error 1)
#
# Nested ROOTLESS podman never needed them — it creates its own userns and
# gets the caps there — which is why the base went without for so long.
#
# What this does NOT grant: under --userns=auto these caps are namespaced,
# so they apply to the container's own netns and nothing of the host's.
# The exception is Network=host, where the netns IS the host's and
# NET_ADMIN really does mean the host's networking — drop them there.
AddCapability=SYS_ADMIN SYS_NICE MKNOD NET_ADMIN NET_RAW

# SELinux: the one remaining relaxation — container_t breaks boot.
SecurityLabelDisable=true

# Auto-allocated userns from /etc/subuid[containers]. Size=200000 so the
# image's inner subuid pool (100000:65536) fits for nested podman.
UserNS=auto:size=200000

# No native [Container] keys for these (podman 5.x).
PodmanArgs=--systemd=always
PodmanArgs=--cgroupns=private

Tmpfs=/run
Tmpfs=/tmp
Tmpfs=/var/tmp

# Persistent state — REQUIRED, not a drop-in. The container is
# recreated on every stop/reload/boot, so everything writable lives on
# the host under /srv/<name> (derived from the unit name via %p, so
# mybox-1.container gets /srv/mybox-1 and never collides).
#
# ONE bind carries the system state. /.mybox holds an overlay upper per
# image-owned tree, which /usr/libexec/mybox/preinit mounts before systemd
# starts:
#
#   /.mybox/etc  ->  /etc  (overlay)   /.mybox/usr  ->  /usr (overlay)
#   /.mybox/var  ->  /var  (bind)      /.mybox/opt  ->  /opt (bind)
#
# It is mounted at a path that is NEVER itself overlaid, because the kernel
# refuses overlayfs as an upperdir — an upper stored inside /var stops
# working the moment /var is an overlay.
#
#   /.mybox/var/lib/{containers,flatpak}   bulk payloads — ordinary
#                                          subdirectories of the /var bind
#
# /home and /srv stay plain binds: they hold no image content to layer
# over, and /srv is empty by contract for nested quadlets to fill.
#
# `:idmap` keeps host-side ownership at the container's numeric UIDs.
# Factory reset: stop → sudo rm -rf /srv/<name>/{etc,var}/diff → start,
# which resets configuration WITHOUT touching /home or the bulk payloads.
# Throwaway instance: give it its own name, delete /srv/<name> after.
# Per-instance runtime config, read HOST-side at start and handed to the
# container's env, where PID 1 carries it to mybox-user-setup. This is the
# natural home for what differs BETWEEN boxes — the login name, uid, ssh
# keys — because it lives with the instance's state rather than in the
# repo: mybox-1 and mybox-2 each get their own.
#
# The ExecStartPre below creates it empty, and that is load-bearing:
# podman fails the whole start on a missing --env-file. Anything set with
# Environment= in a drop-in OVERRIDES this file, so the shipped
# 05-user.conf leaves its lines commented.
EnvironmentFile=/srv/%p/container.env

Volume=/srv/%p:/.mybox:idmap
Volume=/srv/%p/home:/home:idmap
Volume=/srv/%p/srv:/srv:idmap

# /dev/net/tun: pasta opens it in-namespace — without it every nested
# rootless `podman run` fails. /dev/fuse: flatpak's document portal
# (hard FUSE dep) + the fuse-overlayfs storage fallback on ephemeral
# runs. Devices only — no extra capabilities for this.
AddDevice=/dev/fuse
AddDevice=/dev/net/tun

# Sessions inherit PID 1's memlock limit (image ships no limits.d entry —
# pam_limits would fail user@.service when the cap is lower). 3 GiB
# covers real-time audio, Wine/Proton, mmap-heavy loads.
Ulimit=memlock=3221225472:3221225472

# Network — pick ONE (switch via `MYBOX_NETFILE=… just install`):
#   mybox-nat.network   podman bridge + NAT, works anywhere. Inbound via
#                       PublishPort= (see 85-publish-ssh.conf)
#   mybox-lan.network   macvlan: the container is its own host on the LAN
#                       with its own DHCP lease. Wired NIC only, and the
#                       HOST cannot reach it (kernel rule)
#   host                share the host netns entirely (sshd on :2222)
Network=mybox-nat.network

# DNS is baked into the image (resolved.conf.d + nsswitch `resolve`) —
# netavark's DHCP overwrites /etc/resolv.conf, so DNS= here would not
# survive.

AutoUpdate=registry

# The workload is a full systemd PID 1 — journald flush, nested podman
# containers, unit stop jobs — and podman's 10s default expires long before
# that finishes, so every stop ends in SIGKILL. That is not just untidy: the
# unit lands in `failed`, which trips the gui instance's OnFailure= and
# spuriously starts the headless one on every ordinary restart.
#
# Quadlet does NOT derive systemd's own stop timeout from this — it stays
# at 15s and would kill the unit while podman is still waiting — so
# TimeoutStopSec= in [Service] has to be raised to match.
StopTimeout=45

[Service]
Restart=on-failure
TimeoutStartSec=600

# The state dirs are created on demand, so a new <name>.container just
# works — no manual mkdir before the first start. Nothing is SEEDED any
# more: each tree's content comes from the image as the overlay's lower,
# so an empty upper is a complete /etc, and a newer image's changes show
# through instead of being frozen at whatever was copied once.
ExecStartPre=/usr/bin/mkdir -p /srv/%p/etc /srv/%p/var /srv/%p/usr /srv/%p/opt /srv/%p/home /srv/%p/srv
# EnvironmentFile= above is fatal when absent, so guarantee it exists.
ExecStartPre=/usr/bin/touch /srv/%p/container.env

# Must exceed StopTimeout= above (podman's own wait), or systemd kills the
# unit first and the 45s is never actually available.
TimeoutStopSec=60

# No [Install] here: it would apply to both instances and boot-start the
# GUI one, whose bind sources do not exist yet. It lives in
# mybox@headless.container instead.
