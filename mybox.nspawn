# ====================================================================
# mybox.nspawn — hardened nspawn container (SECONDARY runtime)
# ====================================================================
#
# Incus (containers/incus.yaml) is the PRIMARY daily-driver; this nspawn
# config is the no-daemon / systemd-native fallback. Raw LXC was removed.
# Same image, same socket paths, same UID model as incus.
#
# Two costs vs incus, by design (nspawn has no privileged daemon doing
# orchestration for you):
#   * Flatpak / nested podman need proc-unmask.service (baked into the
#     image at system/usr/lib/systemd/system/proc-unmask.service) because
#     nspawn over-masks /proc; incus avoids this via lxcfs + LSM denials.
#   * GPU / virt / input need a cgroup `DeviceAllow=` drop-in installed
#     under systemd-nspawn@mybox.service.d/ (nspawn/*.service.conf),
#     because nspawn ignores .nspawn.d/ drop-ins.
#
# Runs: GUI apps, Flatpak (bubblewrap), rootless+rootful podman, NVIDIA
# GL/Vulkan, VMs. Default config: GUI apps render as wayland clients of
# the host compositor. To run a compositor INSIDE (niri/sway/etc.
# owning the physical display), uncomment the [Files] block tagged
# "compositor inside" and install nspawn/50-input.service.conf.
#
# --------------------------------------------------------------------
# In-container prerequisites (live in the rootfs, do once)
# --------------------------------------------------------------------
#
# 1. File caps on rootless-podman helpers. PrivateUsersOwnership=map
#    (set below) preserves them; chown would strip them.
#
#       sudo setcap cap_setuid+ep /usr/bin/newuidmap
#       sudo setcap cap_setgid+ep /usr/bin/newgidmap
#
# 2. Procfs unmask service. nspawn masks /proc/kcore /proc/keys
#    /proc/sysrq-trigger /proc/timer_list /proc/kallsyms, which
#    makes the kernel reject bwrap's nested procfs mount. A second
#    unmasked procfs at /run/proc-unmasked + rw /proc/sys unblocks
#    flatpak/podman. Save as /etc/systemd/system/proc-unmask.service:
#
#       [Unit]
#       Description=Unmask procfs for bwrap (flatpak/podman)
#       DefaultDependencies=no
#       Before=local-fs.target sysinit.target
#       RequiresMountsFor=/run
#
#       [Service]
#       Type=oneshot
#       RemainAfterExit=yes
#       ExecStart=/usr/bin/mount -o remount,rw /proc/sys
#       ExecStart=/usr/bin/mkdir -p /run/proc-unmasked
#       ExecStart=/usr/bin/mount -t proc proc /run/proc-unmasked
#       ExecStop=-/usr/bin/umount /run/proc-unmasked
#       ExecStop=-/usr/bin/mount -o remount,ro /proc/sys
#
#       [Install]
#       WantedBy=sysinit.target
#
#    Enable: sudo systemctl enable --now proc-unmask.service
#
# 3. The IN-CONTAINER /etc/subuid (baked in the image) declares
#    user:100000:65536 for nested rootless podman. The 200000-UID
#    PrivateUsers range below covers it (100000+65536 = 165536 < 200000).
#    This is independent of the HOST /etc/subuid (a host may ship e.g.
#    <user>:100000:1000000 / root:1500000:200000 / containers:…) —
#    nspawn run as root writes the uid_map directly and does NOT consult
#    the host /etc/subuid at all (see PrivateUsers note below).
#
# --------------------------------------------------------------------
# NVIDIA userland (optional, only if you want GPU acceleration)
# --------------------------------------------------------------------
#
# Userland inside the container MUST match the host driver version
# exactly. Install the cgroup drop-in first:
#
#       sudo install -D -m 0644 \
#           mybox/nspawn/40-gpu-nvidia.service.conf \
#           /etc/systemd/system/systemd-nspawn@mybox.service.d/40-gpu-nvidia.conf
#       sudo systemctl daemon-reload
#
# Then install matching userland inside the container. Pick one:
#
# (a) `mybox` recipe — distro-agnostic, recommended. The CLI and its
#     recipe modules are bind-mounted by the [Files] block at the
#     bottom of this file (mirrored in incus's default profile).
#     After the container is up:
#
#       sudo machinectl shell mybox /usr/local/bin/mybox install-nvidia
#
#     The recipe reads the host driver version from
#     /sys/module/nvidia/version, installs deps via the container's
#     package manager (dnf/apt/pacman/zypper/apk), downloads
#     NVIDIA-Linux-x86_64-<ver>.run, runs it with --no-kernel-modules.
#     Re-run after every host driver upgrade — nvidia-installer
#     replaces the prior install in place.
#
#     `just` must be in PATH inside the container (Arch: pacman -S
#     just; Debian/Ubuntu: apt install just; Fedora: dnf install
#     just; Alpine: apk add just).
#
# (b) Official .run installer manually (what (a) automates):
#
#       VER=$(cat /sys/module/nvidia/version)   # on HOST
#       URL=https://download.nvidia.com/XFree86/Linux-x86_64/$VER/NVIDIA-Linux-x86_64-$VER.run
#       curl -L -O "$URL"
#       chmod +x NVIDIA-Linux-x86_64-$VER.run
#       sudo ./NVIDIA-Linux-x86_64-$VER.run --no-kernel-modules \
#              --no-kernel-module-source --no-distro-scripts \
#              --no-systemd --silent
#
#     `--no-kernel-modules` is critical: container shares host kernel,
#     must NOT load its own module. Index of all driver versions:
#       https://download.nvidia.com/XFree86/Linux-x86_64/
#
# (c) Fedora rootfs — pin via dnf:
#
#       HOST_VER=$(cat /sys/module/nvidia/version)
#       sudo dnf install \
#           xorg-x11-drv-nvidia-cuda-libs-${HOST_VER} \
#           xorg-x11-drv-nvidia-libs-${HOST_VER} \
#           nvidia-driver-libs-${HOST_VER}
#       # NOT the kmod packages — host module is what's loaded.
#
# Verify: sudo machinectl shell <user>@mybox /usr/bin/nvidia-smi
#
# --------------------------------------------------------------------
# Libvirt / QEMU / virt-manager inside the container (optional)
# --------------------------------------------------------------------
#
# Uncomment the /dev/kvm + /dev/net/tun + /dev/vhost-* Bind block at
# the bottom of [Files]. Install the cgroup drop-in:
#
#       sudo install -D -m 0644 \
#           mybox/nspawn/60-virt.service.conf \
#           /etc/systemd/system/systemd-nspawn@mybox.service.d/60-virt.conf
#       sudo systemctl daemon-reload
#
# Install userland inside:
#
#       sudo pacman -S libvirt qemu-base qemu-system-x86 \
#           virt-manager edk2-ovmf swtpm dnsmasq dmidecode \
#           iptables-nft bridge-utils
#       sudo usermod -aG libvirt,kvm <user>
#       sudo systemctl enable --now libvirtd
#
# Verify: `sudo machinectl shell <user>@mybox /usr/bin/virsh list`
# (empty list is success — daemon is reachable).
#
# --------------------------------------------------------------------
# Compositor-inside extras (only if running niri/sway/etc. inside)
# --------------------------------------------------------------------
#
# Host must be at text-mode target so DRM master is free:
#
#       sudo systemctl set-default multi-user.target
#       sudo systemctl disable gdm sddm lightdm 2>/dev/null || true
#
# Install the input cgroup drop-in:
#
#       sudo install -D -m 0644 \
#           mybox/nspawn/50-input.service.conf \
#           /etc/systemd/system/systemd-nspawn@mybox.service.d/50-input.conf
#       sudo systemctl daemon-reload
#
# Install niri + session userspace inside:
#
#       sudo pacman -S niri seatd polkit \
#           pipewire pipewire-pulse pipewire-audio wireplumber \
#           xdg-desktop-portal-gnome xdg-desktop-portal-gtk \
#           qt6-wayland qt5-wayland xorg-xwayland \
#           foot fuzzel wl-clipboard dbus-broker \
#           mako swayidle swaylock
#       sudo systemctl enable --now seatd
#       sudo usermod -aG seat,video,input,render <user>
#
# Workflow at host text TTY, logged in as your user:
#
#       sudo machinectl start mybox
#       sudo machinectl login mybox    # PAM session, NOT `shell`
#       # inside, as the user:
#       export XDG_RUNTIME_DIR=/run/user/$(id -u)
#       mkdir -p $XDG_RUNTIME_DIR && chmod 700 $XDG_RUNTIME_DIR
#       niri-session
#
# `machinectl login` (not `shell`) is required — niri needs a PAM
# session with logind seat tracking to grab DRM master.
# Ctrl+Alt+F1 → host TTY (container pauses); Ctrl+Alt+F2 → resume.
# ====================================================================

[Exec]
Boot=yes

# Shifted UID range. nspawn run as root writes the uid_map directly, so
# this does NOT need a host /etc/subuid entry — BASE can be any range
# that doesn't overlap one already in use. BASE=1100000 sits just above
# a typical host <user>:100000:1000000 pool (ends 1099999), below root's
# 1500000:200000, and — crucially — disjoint from INCUS's base (1500000),
# so incus and nspawn containers can run side by side without UID
# collisions. RANGE=200000 contains the rootfs + the in-container
# user:100000:65536 subuid block. nspawn's `identity`/`pick`
# shorthands hardcode RANGE at 65536, which breaks rootless podman — use
# explicit BASE:RANGE. Second nspawn machine on the same host → pick yet
# another disjoint BASE (e.g. 1300000:200000).
PrivateUsers=1100000:200000

# Forward container logs to host journal: `journalctl -M mybox`.
LinkJournal=try-guest

# Required ONLY when running a compositor inside the container —
# systemd-udevd needs the NETLINK_KOBJECT_UEVENT socket for hot-plug.
# Bounded by container's userns; does NOT grant control over host
# net config.
# Capability=CAP_NET_ADMIN

# Required ONLY when running a compositor inside — wlroots uses
# seatd instead of negotiating a seat with logind across the
# namespace boundary.
# Environment=WLR_LIBSEAT_NO_LOGIND=1

# Env for GUI apps that connect to the HOST compositor via the
# Bind=…/wayland-1… block below. Harmless when running a compositor
# inside (the inside session creates its own wayland-1 in
# /run/user/1000/ and ignores these).
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=/mnt/host/wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PULSE_SERVER=unix:/mnt/host/pulse/native
Environment=XDG_SESSION_TYPE=wayland

[Network]
# Own LAN IP, appears as an independent machine on the network (parity
# with incus's `lan` profile). macvlan gives the container its own MAC +
# DHCP lease; the HOST cannot reach the container over macvlan (kernel
# limitation). Edit the interface for this host.
MACVLAN=enp1s0

# Alternatives (pick ONE; comment MACVLAN above):
#   Bridge=br0           # veth into an existing host bridge — own LAN IP
#                        # AND host can reach it (use when the NIC is a
#                        # bridge member, e.g. libvirt hosts)
#   VirtualEthernet=yes  # private veth + host-side NAT via networkd;
#                        # expose services with --port=
#   VirtualEthernet=no   # share the host netns (no own IP; simplest, but
#                        # VPN clients inside affect the host)

[Files]
# Idmapped mount (VFS-layer UID translation). No on-disk rewrite,
# preserves security.capability xattr (chown would strip it →
# breaks newuidmap/newgidmap setcaps → breaks rootless podman).
# Requires on-disk UIDs to be in [0, RANGE).
PrivateUsersOwnership=map

# Host compositor sockets at /mnt/host/* paths. `:idmap` translates
# host UID 1000 ownership to container UID 1000 — without it the
# sockets show as nobody under the shifted userns and wayland
# refuses. Comment these when running a compositor inside the
# container (no host sockets to bind anyway).
Bind=/run/user/1000/wayland-1:/mnt/host/wayland-1:idmap
Bind=/run/user/1000/pipewire-0:/mnt/host/pipewire-0:idmap
Bind=/run/user/1000/pulse:/mnt/host/pulse:idmap
# No X11 socket bind: the host keeps :0 only as an ABSTRACT socket
# (@/tmp/.X11-unix/X0), which is netns-scoped and unreachable from a
# container. Run Xwayland INSIDE instead (xorg-xwayland +
# xwayland-satellite → mybox-xwayland.service, user) for a real :0.

# PAM /etc/environment is BAKED into the image as
# /etc/environment.d/gui.conf (mybox/system/etc/environment.d/gui.conf,
# COPY'd by Containerfile via `COPY system/etc /etc`). Loaded by
# systemd-environment-d-generator at user-session start. No bind
# needed.
#
# For nspawn-specific overrides (e.g. wayland-0 vs wayland-1 host
# variation), drop a per-host /etc/environment.d/99-host.conf into
# the container's writable /etc via the persistent-state subvol bind
# below.

# Optional persistent-state binds from host btrfs subvols at
# /srv/machines/mybox/{etc,var,home,srv}. Use when you want the
# rootfs at /var/lib/machines/mybox to stay reproducible (or
# eventually become read-only, myosi-style) while writable state
# lives outside. Create the subvols first:
#       for D in etc var home srv; do
#         sudo btrfs subvolume create /srv/machines/mybox/$D
#       done
# Bind=/srv/machines/mybox/etc:/etc:idmap
# Bind=/srv/machines/mybox/var:/var:idmap
# Bind=/srv/machines/mybox/home:/home:idmap
# Bind=/srv/machines/mybox/srv:/srv:idmap

# Required ONLY when running a compositor inside. Also install
# _features/50-input.service.conf for the cgroup DeviceAllow=
# permissions.
#   /dev/input   — keyboards, mice, touchpads, gamepads
#   /dev/uinput  — synthetic input (Steam Input, Sunshine)
#   /dev/tty0    — active-VT marker logind reads
#   /dev/tty1-4  — real VTs the compositor can grab
# Bind=/dev/input
# Bind=/dev/uinput
# Bind=/dev/tty0
# Bind=/dev/tty1
# Bind=/dev/tty2
# Bind=/dev/tty3
# Bind=/dev/tty4

# GPU + audio device nodes. No `:idmap` — kernel uses device cgroup
# for permissions, not inode ownership.
Bind=/dev/dri
Bind=/dev/snd

# /dev/net/tun — default-on for nested rootless podman's pasta (every
# rootless container creates a tap here), plus WireGuard / Tailscale /
# OpenVPN / libvirt tap-mode VMs. Parity with incus's default profile.
# REQUIRES installing nspawn/70-tun.service.conf for the cgroup
# DeviceAllow= (otherwise the node exists but open() returns EPERM):
#   sudo install -D -m 0644 ~/mybox/nspawn/70-tun.service.conf \
#       /etc/systemd/system/systemd-nspawn@mybox.service.d/70-tun.conf
#   sudo systemctl daemon-reload
Bind=/dev/net/tun

# NVIDIA device nodes. Pair with _features/40-gpu-nvidia.service.conf
# (cgroup DeviceAllow=) and matching userland inside the container
# (see header NVIDIA section).
#
# /dev/nvidia-uvm only exists after `modprobe nvidia_uvm` runs on
# the host (no in-container module loading possible). Preload at
# host boot with /etc/modules-load.d/nvidia.conf:
#       nvidia
#       nvidia_uvm
#       nvidia_modeset
#       nvidia_drm
# Otherwise the container fails to start after a fresh host boot.
#
# Note: nvidia-uvm's major is DYNAMIC (varies per boot/driver). The
# 40-gpu-nvidia.service.conf drop-in allows it via `DeviceAllow=/dev/
# nvidia-uvm rwm` BY PATH, so systemd resolves the live major at load —
# no hardcoding needed. This matters: if uvm is NOT allowed, the NVIDIA
# Vulkan ICD segfaults in vkEnumeratePhysicalDevices and zeroes out every
# GPU (raw LXC had to chase the major by hand; the path rule avoids that).
Bind=/dev/nvidia0
Bind=/dev/nvidiactl
Bind=/dev/nvidia-modeset
Bind=/dev/nvidia-uvm
Bind=/dev/nvidia-uvm-tools

# mybox CLI + recipes are BAKED into the image at:
#   /usr/local/bin/mybox          (from system/usr/local/bin/mybox)
#   /usr/share/mybox/just/*.just  (from system/usr/share/mybox/just/)
#
# No bind needed. For live-recipe-development on the nspawn rootfs,
# uncomment the binds below to shadow the baked-in versions with the
# repo paths — edit on host, immediately visible inside:
#
# Bind=/path/to/mybox/system/usr/local/bin/mybox:/usr/local/bin/mybox
# BindReadOnly=/path/to/mybox/system/usr/share/mybox/just:/usr/share/mybox/just

# /dev/net/tun is bound default-on in the GPU/device block above (for
# pasta + VPNs + tap-mode VMs); install nspawn/70-tun.service.conf for
# its cgroup DeviceAllow=.

# Required ONLY when running VMs inside the container (libvirt /
# qemu / virt-manager). Also install nspawn/60-virt.service.conf for
# the cgroup DeviceAllow= permissions and matching userland inside
# (libvirtd + qemu). If the VMs use tap-mode networking, ALSO add
# the /dev/net/tun Bind above + install 70-tun.service.conf.
#   /dev/kvm          — KVM hardware acceleration
#   /dev/vhost-net    — virtio-net offload (perf)
#   /dev/vhost-vsock  — vsock between container and its guest VMs
# Bind=/dev/kvm
# Bind=/dev/vhost-net
# Bind=/dev/vhost-vsock
