# eth0 DHCP config for incus / raw lxc ONLY.
#
# Their container NIC is eth0 bridged to a bridge that runs a DHCP
# server, and stock systemd ships no active eth0 config — so eth0 needs
# a DHCP client. (nspawn doesn't need this: its NIC is host0, handled by
# systemd's built-in 80-container-host0.network.)
#
# Virtualization=!podman scopes it away from podman. Under podman
# netavark configures eth0 itself BEFORE PID 1 (static IP on the default
# bridge, or a LAN IP via macvlan+DHCP); this file must NOT match, or
# networkd would adopt eth0, find no lease, and flush the runtime IP.
# With no match, networkd leaves eth0 unmanaged (podman owns it) and
# systemd-networkd-wait-online has nothing to wait on — so networkd and
# every one of its units run unmasked under all runtimes.
[Match]
Name=eth0
Virtualization=!podman

[Network]
DHCP=yes
IPv6AcceptRA=yes
