[Unit]
Description=Ensure flathub remote is configured (system-wide)
# Marker-gated oneshot. /var/lib/mybox/.marks/flatpak-setup.done is
# created on success; service skips on subsequent boots.
ConditionPathExists=!/var/lib/mybox/.marks/flatpak-setup.done
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /var/lib/mybox/.marks
# `-`: registering a remote needs the network, and an offline boot must
# not leave the whole system `degraded` over an optional convenience.
# The script writes the marker itself, as its last step, so it lands
# ONLY on success and a failed attempt simply retries next boot — an
# ExecStartPost= could not tell the difference ($EXIT_STATUS is set for
# ExecStop*= only, so it would stamp the marker either way).
ExecStart=-/usr/libexec/mybox/flatpak-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
