# Seed /etc from /usr/share/factory/etc — first boot of an empty
# persistent /etc bind only. A populated /etc (image's own, or user
# state) fails the condition and is never touched. New factory files
# from an image upgrade do NOT propagate into a populated bind — /etc
# reflects what the user put there, no auto-sync.
#
# The quadlet path pre-seeds host-side (mybox.container ExecStartPre) because
# PID 1 reads /etc before any unit runs; this service is the fallback.

[Unit]
Description=Seed /etc from /usr/share/factory/etc (first boot only)
Documentation=https://github.com/aboglioli/mybox/blob/main/README.md
DefaultDependencies=no
Before=basic.target sysinit.target local-fs.target
# Before (NOT After) tmpfiles: After=tmpfiles here formed an ordering
# CYCLE with Before=local-fs and systemd dropped this unit from the
# first-boot transaction, leaving /etc empty. Seeding must precede
# every /etc writer anyway.
Before=systemd-tmpfiles-setup.service
ConditionPathExists=/usr/share/factory/etc
ConditionDirectoryNotEmpty=!/etc

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/cp -a /usr/share/factory/etc/. /etc/

[Install]
WantedBy=sysinit.target
