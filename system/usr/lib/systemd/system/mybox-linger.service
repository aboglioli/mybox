# Enable linger for the runtime-configured user at every boot, so its
# user@<UID>.service (and thus /run/user/<UID> + the user D-Bus) comes
# up WITHOUT a prior PAM login. Nested rootless podman via
# `podman exec -u <user>` needs that runtime dir; without linger it
# fails with "RunRoot ... is not writable".
#
# Why a boot oneshot instead of the build-time marker file:
# systemd-logind.service declares `StateDirectory=systemd/linger`, so
# systemd re-provisions /var/lib/systemd/linger when logind starts and
# the image-baked marker does not survive. Running `loginctl
# enable-linger` AFTER logind is up is the robust, idempotent path.
#
# The user is resolved from the same env vars mybox-user-setup.service
# consumes (MYBOX_UID, falling back to MYBOX_USER, then `user`).
[Unit]
Description=Enable linger for the mybox user
After=systemd-logind.service dbus.service mybox-user-setup.service
Wants=systemd-logind.service

[Service]
Type=oneshot
RemainAfterExit=yes
# MYBOX_UID/MYBOX_USER come from podman's env, which PID 1 does NOT
# propagate to units — extract them from /proc/1/environ.
ExecStart=/bin/bash -c 'uid=$(tr "\0" "\n" < /proc/1/environ | sed -n "s/^MYBOX_UID=//p"); name=$(tr "\0" "\n" < /proc/1/environ | sed -n "s/^MYBOX_USER=//p"); loginctl enable-linger "$(id -nu "${uid:-1000}" 2>/dev/null || echo "${name:-user}")"'

[Install]
WantedBy=multi-user.target
