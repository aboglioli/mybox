[Unit]
# Container runtimes mount /proc/sys read-only as hardening; bubblewrap
# (flatpak's sandbox) needs to write /proc/sys/user/max_user_namespaces
# during its userns setup or `flatpak run` fails with
# "bwrap: cannot open /proc/sys/user/max_user_namespaces: Read-only
# file system". Remount /proc/sys rw and expose an unmasked procfs at
# /run/proc-unmasked for bwrap's nested procfs mount.
Description=Unmask procfs for bwrap (flatpak / podman nested sandbox)
DefaultDependencies=no
Before=local-fs.target sysinit.target
RequiresMountsFor=/run
ConditionVirtualization=container

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mount -o remount,rw /proc/sys
ExecStart=/usr/bin/mkdir -p /run/proc-unmasked
ExecStart=/usr/bin/mount -t proc proc /run/proc-unmasked
ExecStop=-/usr/bin/umount /run/proc-unmasked
ExecStop=-/usr/bin/mount -o remount,ro /proc/sys

[Install]
WantedBy=sysinit.target
