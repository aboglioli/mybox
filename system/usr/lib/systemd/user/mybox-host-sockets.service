# Symlink the host GUI/audio sockets (/mnt/host/*, see 10-gui.conf) into
# XDG_RUNTIME_DIR so wayland/pulse/pipewire and flatpak --socket=* find
# them at the standard paths. See the script for the rationale.
#
# Enabled for every session by `systemctl --global enable` at image
# build time. A clean no-op on a box without 10-gui.conf.
[Unit]
Description=Link host GUI/audio sockets into XDG_RUNTIME_DIR
ConditionPathIsDirectory=/mnt/host

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mybox/link-host-sockets

[Install]
WantedBy=default.target
