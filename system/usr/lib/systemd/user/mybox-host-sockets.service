# Symlink host GUI/audio sockets (/mnt/host/*, bound by the container
# runtime) into XDG_RUNTIME_DIR so wayland/pulse/pipewire and flatpak
# --socket=* discover them at the standard paths. See the script for the
# rationale (logind wipes /run/user at login, so the runtime binds land
# at /mnt/host and we relink them here, per user session).
#
# Autostarted by the user default.target drop-in (Upholds=). No-op with
# no host binds (compositor-inside / headless) via the Condition below.
[Unit]
Description=Link host GUI/audio sockets into XDG_RUNTIME_DIR
ConditionPathExistsGlob=/mnt/host/*
Before=mybox-xwayland.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mybox/link-host-sockets

[Install]
WantedBy=default.target
