# Xwayland INSIDE the container, as a client of the host Wayland
# compositor — gives a real in-container DISPLAY=:0 (matches gui.conf).
# Started by mybox-xwayland.path when the host socket appears; it exits
# with the compositor, and the path unit starts it again with the next.
#
# Why not the host's :0: niri/xwayland-satellite keep :0 only as an
# ABSTRACT socket (@/tmp/.X11-unix/X0), and abstract sockets are network-
# namespace scoped, so a container can never reach it.
#
# Why not the packaged xwayland-satellite.service: it BindsTo
# graphical-session.target, which never activates in a client-of-host box
# (no compositor here).
[Unit]
Description=Xwayland inside the container (host :0 is unreachable)
ConditionPathExists=/usr/bin/xwayland-satellite
Requires=mybox-host-sockets.service
After=mybox-host-sockets.service

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/xwayland-satellite :0
