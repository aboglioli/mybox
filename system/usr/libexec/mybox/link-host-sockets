#!/usr/bin/env bash
# Client-of-host GUI: 10-gui.conf binds the host's %t/mybox-gui directory
# at /mnt/host — NOT under /run/user, which logind re-creates as a fresh
# tmpfs at login and would shadow. The host's mybox-gui.service hard links
# the session's sockets into it while a desktop session runs, so they may
# be absent now and appear later.
#
# So link the three known names into XDG_RUNTIME_DIR unconditionally:
# dangling while no session runs, live the moment one starts, and live
# again after a compositor restart — without this script running again.
# libwayland, libpulse, pipewire and flatpak's --socket=* then find them
# at the standard paths with no per-app env.
#
# pulse/ is a REAL directory with only the socket linked: libpulse opens
# $XDG_RUNTIME_DIR/pulse with O_NOFOLLOW to check it is private, and
# refuses a symlinked one with "Too many levels of symbolic links".
#
# NEVER link a `bus`: /run/user/<uid>/bus is the box's OWN session bus;
# a host bus over it would break nested rootless podman's cgroup manager.
# Wired via mybox-host-sockets.service (ConditionPathIsDirectory=/mnt/host).
set -eu

run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$run"

for name in wayland-1 pipewire-0 pulse/native; do
    dir="$run/$(dirname -- "$name")"
    [ -L "$dir" ] && rm -f "$dir"
    [ -d "$dir" ] || mkdir -m 0700 "$dir"
    ln -sfn "/mnt/host/$name" "$run/$name"
done
