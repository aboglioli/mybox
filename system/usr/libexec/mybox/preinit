#!/usr/bin/env bash
# PID 1 pre-init: assemble the root filesystem, then exec the real init.
#
#   image /<tree>  (lower)  +  /.mybox/<tree>/diff  (upper)  ->  /<tree>
#
# for etc, var, usr and opt. The image tree IS the lower, so nothing needs
# seeding and a newer image shows through wherever you have not changed it.
#
# This is mybox's initrd. It has to run as PID 1 because systemd reads /etc
# — machine-id, preset symlinks, masks — before any unit could mount an
# overlay over it, and /usr must be in place before the boot transaction is
# built or a runtime-installed unit is a dangling enable.
#
# Every upper lives in ONE host bind that is never itself overlaid: the
# kernel refuses overlayfs as an upperdir, so an upper under /var would
# break the moment /var became an overlay.
#
# Fatal on anything that would silently discard writes. The only failure
# tolerated is publishing the read-only lowers, which costs `mybox diff`
# and nothing else.
set -uo pipefail

STATE=/.mybox                 # host bind; holds every upper
RUNTIME=/run/mybox            # published lowers + parked mounts
PARK=$RUNTIME/preserved
TREES=(etc var usr opt)

# Bulk, not image-derived, and a factory reset of /var must not drop them.
BULK=(var/lib/containers var/lib/flatpak)

# podman gives this its own tmpfs; letting the /var overlay bury it is what
# keeps the journal RAM-backed and per-boot, so it is deliberately not parked.
NO_PARK=/var/log/journal

# /sbin/init is a symlink on most distros, but guaranteed on none.
INITS=(/usr/lib/systemd/systemd /lib/systemd/systemd /sbin/init /usr/sbin/init)

parked=()

warn() { printf 'preinit: %s\n' "$*" >&2; }
die()  { warn "FATAL: $*"; exit 1; }

# Bind $1 onto $2, creating $2 as the same kind of object as $1.
rebind() {
    local src=$1 dst=$2
    if [ -d "$src" ]; then mkdir -p "$dst"; else [ -e "$dst" ] || : > "$dst"; fi
    mount --bind "$src" "$dst"
}

# Flat, collision-free name under $PARK for an absolute path.
park_path() { printf '%s/%s' "$PARK" "${1//\//_}"; }

# Mounts the runtime placed INSIDE a tree we are about to overlay would
# vanish under it: podman's /etc/{hosts,hostname,resolv.conf}, the quadlet's
# /var/tmp. Park them as binds — not copies, podman may still rewrite them —
# and put them back once the overlay is up. Read from mountinfo so the list
# stays the runtime's business rather than a hardcoded guess.
park_runtime_mounts() {
    local target inside=() re
    # Matches any path INSIDE one of the trees: ^/(etc|var|usr|opt)/
    re="^/($(IFS='|'; printf '%s' "${TREES[*]}"))/"

    # Snapshot first: parking changes mountinfo underneath the loop.
    while read -r _ _ _ _ target _; do
        [[ $target =~ $re && $target != "$NO_PARK" ]] && inside+=("$target")
    done < /proc/self/mountinfo

    mkdir -p "$PARK"
    for target in "${inside[@]}"; do
        if rebind "$target" "$(park_path "$target")"; then
            parked+=("$target")
        else
            warn "could not park $target — the overlay will hide it"
        fi
    done
}

unpark_runtime_mounts() {
    local target
    for target in "${parked[@]}"; do
        rebind "$(park_path "$target")" "$target" || warn "could not restore $target"
        umount "$(park_path "$target")" 2>/dev/null || true
    done
    rm -rf "${PARK:?}"
}

# Once the overlay is mounted its lower has no name left, so publish it
# read-only first. That is the real lower, not a copy, which is what lets
# `mybox diff` and `mybox prune` compare against what the box actually runs.
publish_lower() {
    local tree=$1 pub=$RUNTIME/lower/$1
    mkdir -p "$pub" || { warn "cannot create $pub"; return; }
    mount --bind "/$tree" "$pub" || { warn "cannot publish /$tree"; return; }
    mount -o remount,bind,ro "$pub" || warn "$pub stays writable"
}

overlay_tree() {
    local tree=$1 upper=$STATE/$1/diff work=$STATE/$1/work

    if mountpoint -q "/$tree"; then
        die "/$tree is already a mountpoint — something mounted it before the pre-init"
    fi
    mkdir -p "/$tree" "$upper" "$work" || die "cannot create $STATE/$tree"

    publish_lower "$tree"

    # userxattr: unprivileged whiteouts, required inside a user namespace.
    # It also forces redirect_dir=nofollow, so renaming a directory that
    # exists only in the lower fails EXDEV — `mv` copies instead, but a raw
    # rename(2) does not. The two options are mutually exclusive; userxattr
    # is not optional here.
    mount -t overlay "mybox-$tree" \
        -o "lowerdir=/$tree,upperdir=$upper,workdir=$work,userxattr" "/$tree" ||
        die "could not overlay /$tree — it would stay read-only image content"
}

# After the overlays, or the /var overlay hides them. podman cannot do this
# for us: anything it mounts lands before this script runs.
bind_bulk_payloads() {
    local path
    for path in "${BULK[@]}"; do
        mkdir -p "$STATE/$path" "/$path" || die "cannot create /$path"
        # Unbound these land in the /var upper, where a factory reset of
        # /var would delete every container image and flatpak app.
        mount --bind "$STATE/$path" "/$path" || die "could not bind /$path"
    done
}

exec_init() {
    local init
    for init in "${INITS[@]}"; do
        [ -x "$init" ] && exec "$init" "$@"
    done
    die "no init found in ${INITS[*]}"
}

mountpoint -q "$STATE" ||
    die "$STATE is not a mount — the host state bind is missing, so every write would die with the container"

park_runtime_mounts
for tree in "${TREES[@]}"; do overlay_tree "$tree"; done
unpark_runtime_mounts
bind_bulk_payloads

exec_init "$@"
