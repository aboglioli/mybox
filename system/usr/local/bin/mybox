#!/usr/bin/env bash
# mybox — in-container management CLI. Scans /usr/share/mybox/just/
# *.just modules, generates a transient justfile importing each, execs
# just against it. Slot convention: 00-49 shipped modules, 50-99 local
# additions.
#
# Usage:
#   mybox                       # list recipes
#   mybox <recipe> [args...]    # run a recipe

set -euo pipefail

JUST_DIR="${MYBOX_JUST_DIR:-/usr/share/mybox/just}"
# Transient justfile under $XDG_RUNTIME_DIR (per-user tmpfs); /tmp
# fallback for environments without it (boot-time, root shells).
RUN_BASE="${XDG_RUNTIME_DIR:-/tmp/mybox-$(id -u)}"
RUN_JUSTFILE="${MYBOX_RUN_JUSTFILE:-$RUN_BASE/mybox/justfile}"

if [ ! -d "$JUST_DIR" ]; then
    echo "ERROR: $JUST_DIR not found — runtime bind missing?" >&2
    exit 1
fi

mkdir -p "$(dirname "$RUN_JUSTFILE")"

{
    printf '# Auto-generated by /usr/local/bin/mybox. Do not edit.\n'
    printf '# Scanned: %s\n\n' "$JUST_DIR"
    printf 'default:\n    @just -f "%s" --list --unsorted\n\n' "$RUN_JUSTFILE"
    find "$JUST_DIR" -maxdepth 1 -type f -name '*.just' \
        | sort \
        | while IFS= read -r f; do printf 'import "%s"\n' "$f"; done
} > "$RUN_JUSTFILE"

if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ] || [ -z "${1:-}" ]; then
    exec just -f "$RUN_JUSTFILE" --list --unsorted
fi

exec just -f "$RUN_JUSTFILE" "$@"
