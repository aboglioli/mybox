#!/usr/bin/env bash
# mybox — user entry point for in-container management of any
# container launched from this repo (raw LXC, incus profiles, or
# systemd-nspawn). Parallel to the myosi host-side CLI
# (user-space): scan a directory of *.just modules, generate a
# transient justfile that imports each one, exec just against it.
#
# Module discovery:
#   /usr/share/mybox/just/*.just          recipe modules
#
# Slot convention:
#   00-49  base modules shipped with the repo (always present)
#   50-99  per-container additions (drop new *.just into the same
#          dir if you want extras for one box)
#
# Both `/usr/local/bin/mybox` (this script) and `/usr/share/mybox/just/`
# (the modules) get baked into the image and can also be bind-mounted
# into the container by runtime config for live repo edits.
#
# Usage:
#   mybox                       # list recipes
#   mybox --list | -l           # list recipes
#   mybox <recipe> [args...]    # run a recipe

set -euo pipefail

JUST_DIR="${MYBOX_JUST_DIR:-/usr/share/mybox/just}"
# Transient justfile lives under $XDG_RUNTIME_DIR (per-user tmpfs)
# when set — works for any UID. Falls back to /tmp/mybox-<uid>/ for
# environments without XDG_RUNTIME_DIR (boot-time, root shells).
RUN_BASE="${XDG_RUNTIME_DIR:-/tmp/mybox-$(id -u)}"
RUN_JUSTFILE="${MYBOX_RUN_JUSTFILE:-$RUN_BASE/mybox/justfile}"

if [ ! -d "$JUST_DIR" ]; then
    echo "ERROR: $JUST_DIR not found — runtime bind missing?" >&2
    exit 1
fi

mkdir -p "$(dirname "$RUN_JUSTFILE")"

{
    printf '# Auto-generated by /usr/local/bin/mybox. Do not edit.\n'
    printf '# Scanned: %s\n\n' "$JUST_DIR"
    printf 'default:\n    @just -f "%s" --list --unsorted\n\n' "$RUN_JUSTFILE"
    find "$JUST_DIR" -maxdepth 1 -type f -name '*.just' \
        | sort \
        | while IFS= read -r f; do printf 'import "%s"\n' "$f"; done
} > "$RUN_JUSTFILE"

if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ] || [ -z "${1:-}" ]; then
    exec just -f "$RUN_JUSTFILE" --list --unsorted
fi

exec just -f "$RUN_JUSTFILE" "$@"
